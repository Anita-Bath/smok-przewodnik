{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Pagination": {
    "SigningKey": "local-development-key-change-before-deploying"
  },
  "Supabase": {
    "Url": "https://example.supabase.co",
    "Audience": "authenticated",
    "ClaimRole": "authenticated"
  },
  "Valhalla": {
    "BaseUrl": "http://localhost:8002",
    "TimeoutSeconds": 10,
    "Alternates": 2
  },
  "NavigationCleanup": {
    "IntervalMinutes": 15
  },
  "AllowedHosts": "*"
}
